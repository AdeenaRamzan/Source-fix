# Copy this file to `.env` in the same directory (backend/.env) and fill in
# real values. NEVER commit the real .env -- it's listed in .gitignore.
#
# Only /api/analyze and /api/analyze/stream need these (they run the full
# LLM negotiation loop). /api/baseline never calls an LLM and works with no
# keys set at all.

# Used by both propose_relaxation_node and rank_and_finalize_node
# (app/agent/nodes.py). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
